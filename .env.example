# Supabase (the shared Yavqo project; AIHub uses only aihub_* tables)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to verify API keys and write usage logs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The deployed Sunlight gateway (server only)
GATEWAY_BASE_URL=https://api.ai.yavqo.com/v1
GATEWAY_API_KEY=

# Requests per minute per API key
RATE_LIMIT_PER_MIN=60
# Public URL of this app, used in docs and code samples
NEXT_PUBLIC_APP_URL=http://localhost:3000
